: 1
name: libfftw3
version: 3.3.10
language: c
project: fftw3
summary: Discrete Fourier transform C library
license: GPL-2.0-or-later ; GNU General Public License v2.0 or later.
topics: discrete Fourier transform, FFT, DFT, DCT, signal processing
description-file: README
package-description-file: PACKAGE-README.md
changes-file: NEWS
url: https://www.fftw.org/
doc-url: https://www.fftw.org/fftw3_doc/
src-url: https://github.com/FFTW/fftw3
email: fftw@fftw.org
package-url: https://github.com/build2-packaging/fftw3
package-email: packaging@build2.org ; Mailing list.
depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0

extras-build-config:
\
config.libfftw3.single=true
config.libfftw3.long_double=true
config.libfftw3.threads=true
;
Build the single and long double precision and the threads libraries.
\

openmp-builds: &( +gcc +clang )                  ; GCC or Clang.
openmp-builds: -windows                          ; Not supported on Windows.
openmp-builds: -macos                            ; No OpenMP runtime with Apple Clang.
openmp-build-exclude: linux_debian**-clang**     ; No OpenMP runtime with Clang on Debian.
openmp-build-config: config.libfftw3.openmp=true ; Build the OpenMP library.

quad-builds: &gcc ; GCC.
quad-build-exclude: linux_fedora** ; See quad-fedora.
quad-build-include: **/x86_64-**
quad-build-include: **/i?86-**
quad-build-exclude: ** ; GCC on x86 or x86_64 only.
quad-build-config:
\
config.libfftw3.quad_precision=true
;
Build the quad precision library.
\

quad-fedora-builds: &gcc ; GCC.
quad-fedora-build-include: linux_fedora**-bindist/x86_64-**
quad-fedora-build-exclude: ** ; Fedora with sudo on x86_64 only.
quad-fedora-build-config:
\
config.libfftw3.quad_precision=true
bpkg.configure.build:--sys-install
bpkg.configure.build:--sys-yes
bpkg.configure.build:--sys-no-stub
sys:libquadmath
;
Build the quad precision library, installing libquadmath-devel.
\
